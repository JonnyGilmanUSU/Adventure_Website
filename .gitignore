# Root-level ignores
# Ignore node_modules for both client and server
node_modules/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Ignore environment variable files
.env
.env.production
.env.development

# Ignore build directories
client/build/
server/dist/

# Ignore OS-specific files
.DS_Store
Thumbs.db

# Ignore IDE/editor-specific files
.idea/
.vscode/
*.swp
*.swo

# Ignore temporary files
*.tmp
*.temp

# Specific to client (React app)
client/.env
client/.env.production
client/.env.development

# Ignore client build output (already covered globally, but specific for clarity)
client/build/

# Specific to server (Node.js/Express)
server/.env

# Ignore server build output
server/dist/

# Miscellaneous
*.bak
*.old
